use s3
use valk.io

// The server started by tests/server.sh
value TEST_ENDPOINT ("http://127.0.0.1:9100")
value TEST_USER ("valktest")
value TEST_PASSWORD ("valktest-secret")

fn test_config() s3.Config {
    return s3.Config { endpoint: TEST_ENDPOINT, path_style: true, access_key: TEST_USER, secret_key: TEST_PASSWORD }
}

fn client() s3.Client {
    return s3.Client.new(test_config()) !!
}

// An empty bucket of its own for one test, since tests run at the same time
fn fresh_bucket(c: s3.Client, name: String) String {
    let bucket = "valk-s3-" + name
    if c.bucket_exists(bucket) !! {
        let keys = Array[String]{}
        each (c.list_all(bucket) !!).objects as obj : keys.append(obj.key)
        if keys.length > 0 : c.delete_objects(bucket, keys) !!
    } else {
        c.create_bucket(bucket) !!
    }
    return bucket
}

// `size` bytes that differ from part to part
fn pattern(size: uint, seed: uint (7)) String {
    let buf = ByteBuffer.new(size)
    let x = seed
    each 0 .. size {
        x = x * 1103515245 + 12345
        buf.write_byte((x >> 16).to(u8))
    }
    return buf.into_string()
}

// Hands out its data a few bytes at a time
class SlowReader is io.Reader {
    data: String
    pos: uint (0)

    + fn read(buf: local mut &[u8]) uint !io.IoError {
        let n = this.data.length - this.pos
        if n > 1000 : n = 1000
        if n > buf.length : n = buf.length
        each 0 .. n as i : buf[i] = this.data[this.pos + i]
        this.pos += n
        return n
    }
}

// Scratch files of the tests
fn tmp_dir() String {
    return __DIR__ + "/tmp"
}
